// Every exercise in the coached-programme spreadsheets (2023-24), by training-os's slug for it, and
// the Lionheart movement it becomes: a movement base, the equipment, and an optional modifier. The
// same shape as Services/Strong/strong-movements.json, and the same spellings, so a lift the
// Strong history already holds is reused rather than duplicated.
//
// - "slug" is training-os's canonical exercise (derived/sets.tsv, column "exercise"). One slug can
//   cover several spellings in the sheets ("Bench", "Bench Press", "BENCH PRESS").
// - Variations stay separate movements: paused, tempo, high bar, safety bar, spoto, larsen and the
//   rest are modifiers, never folded into the competition lift.
// - "unsure" marks a judgement call and says why. The import lists every unsure mapping it applies.
// - A slug in the sets with no entry here stops the import before anything is written.
//
// Correct a mapping before importing: an imported session is never re-read.
[
  { "slug": "squat-barbell", "base": "Squat", "equipment": "Barbell" },
  { "slug": "tempo-squat", "base": "Squat", "equipment": "Barbell", "modifier": "tempo" },
  { "slug": "paused-squat", "base": "Squat", "equipment": "Barbell", "modifier": "paused" },
  { "slug": "pause-squat", "base": "Squat", "equipment": "Barbell", "modifier": "paused", "unsure": "\"Pause Squat\" (sets of four) and \"Paused Squat\" (singles) sit on the same Day 5 of each block; read as one lift at two rep ranges." },
  { "slug": "paused-ssb-squat", "base": "Squat", "equipment": "Safety Squat Bar", "modifier": "paused" },
  { "slug": "ascending-highbar-squat", "base": "Squat", "equipment": "Barbell", "modifier": "high bar", "unsure": "Ascending means the load or effort rose set to set (\"RPE 6 +=.5\"); the sheet holds one weight, 317 lb, so all four sets are recorded at it." },
  { "slug": "ffe-split-squat", "base": "Split Squat", "equipment": "Dumbbell", "modifier": "front foot elevated", "unsure": "The sheet names no equipment; dumbbells assumed for 100 lb, as the Strong map does." },

  { "slug": "bench-press-barbell", "base": "Bench Press", "equipment": "Barbell" },
  { "slug": "tempo-bench-press", "base": "Bench Press", "equipment": "Barbell", "modifier": "tempo" },
  { "slug": "3-count-pause-bench", "base": "Bench Press", "equipment": "Barbell", "modifier": "paused", "unsure": "A three-count pause, matched to the Strong history's \"3Ct Bench Press\", which maps to paused." },
  { "slug": "potential-pause-bench", "base": "Bench Press", "equipment": "Barbell", "modifier": "potential pause", "unsure": "Competition-style singles where the pause may be called (264-291 lb, the heaviest benches in the sheets). Kept apart from the bench; folding it in would make 291 lb the bench's heaviest set." },
  { "slug": "spoto-bench", "base": "Bench Press", "equipment": "Barbell", "modifier": "spoto" },
  { "slug": "alt-grip-larsen-bench", "base": "Bench Press", "equipment": "Barbell", "modifier": "larsen alternate grip", "unsure": "Coach's note \"Pinky on ring\": a Larsen press at a changed grip, kept as one variation." },
  { "slug": "bench-press-varied-grip", "base": "Bench Press", "equipment": "Barbell", "modifier": "varied grip", "unsure": "\"One finger space in or out from your main grip\": the grip moved week to week, kept as one variation." },
  { "slug": "dumbell-bench", "base": "Bench Press", "equipment": "Dumbbell" },

  { "slug": "deadlift-barbell", "base": "Deadlift", "equipment": "Barbell" },
  { "slug": "paused-deadlift", "base": "Deadlift", "equipment": "Barbell", "modifier": "paused" },
  { "slug": "sumo-deadlift-barbell", "base": "Sumo Deadlift", "equipment": "Barbell" },
  { "slug": "paused-sumo-deadlift", "base": "Sumo Deadlift", "equipment": "Barbell", "modifier": "paused" },
  { "slug": "sumo-1-5-deadlift", "base": "Sumo Deadlift", "equipment": "Barbell", "modifier": "1.5 rep" },
  { "slug": "tempo-sumo-deadlift", "base": "Sumo Deadlift", "equipment": "Barbell", "modifier": "tempo" },
  { "slug": "tempo-1-5-sumo-deadlift", "base": "Sumo Deadlift", "equipment": "Barbell", "modifier": "tempo 1.5 rep", "unsure": "Coach's note: tempo to the knee and back down, then a full rep. Kept apart from the tempo sumo deadlift." },
  { "slug": "tempo-deadlift", "base": "Deadlift", "equipment": "Barbell", "modifier": "tempo" },
  { "slug": "tempo-1-5-deadlift", "base": "Deadlift", "equipment": "Barbell", "modifier": "tempo 1.5 rep", "unsure": "Coach's note: tempo to the knee and back down, then a full rep. Kept apart from the tempo deadlift." },
  { "slug": "1-5-deadlift", "base": "Deadlift", "equipment": "Barbell", "modifier": "1.5 rep" },
  { "slug": "romanian-deadlift", "base": "Romanian Deadlift", "equipment": "Barbell" },
  { "slug": "sldl", "base": "Stiff Leg Deadlift", "equipment": "Barbell" },
  { "slug": "lower-back-extensions", "base": "Back Extension", "equipment": "Machine", "unsure": "135 lb reads as a loaded machine, as the Strong map reads its own back extension." },

  { "slug": "hamstring-curl", "base": "Leg Curl", "equipment": "Machine", "modifier": "lying", "unsure": "The sheet names no machine; the same block's first week records it as \"LLC: 80x11\", a lying leg curl." },
  { "slug": "abductor-machine", "base": "Hip Abductor", "equipment": "Machine" },
  { "slug": "iso-lateral-row", "base": "Iso-Lateral Row", "equipment": "Machine" },
  { "slug": "lat-pulldown", "base": "Lat Pulldown", "equipment": "Cable" },
  { "slug": "chest-press-machine", "base": "Chest Press", "equipment": "Machine" },
  { "slug": "strict-db-curl", "base": "Bicep Curl", "equipment": "Dumbbell", "unsure": "\"Strict\" read as a form cue rather than a different exercise, so folded into the dumbbell curl." }
]
