# ─────────────────────────────────────────────────────────────────────────────
# Which model serves chat.
# "LmStudio" (the default when unset) for development and test; "Anthropic" in production.
# Whichever you pick, you ALSO need the Embedding__* block below — see the note there.
# ─────────────────────────────────────────────────────────────────────────────
Llm__ChatProvider=LmStudio


# ─────────────────────────────────────────────────────────────────────────────
# Anthropic — required when Llm__ChatProvider=Anthropic.
# ─────────────────────────────────────────────────────────────────────────────
Anthropic__ApiKey=sk-ant-your-key

# Optional. Defaults to claude-opus-5-5. Model ids are complete as written: never append a
# date suffix, which names a model that does not exist.
Anthropic__Model=claude-opus-5-5

# Optional: cheaper model for Athlete Context Card narratives. Defaults to Anthropic__Model.
Anthropic__NarrativeModel=claude-haiku-5-5


# ─────────────────────────────────────────────────────────────────────────────
# LM Studio local server (OpenAI-compatible API) — required when
# Llm__ChatProvider=LmStudio, and by the LocalModel tests whatever serves chat.
# BaseUrl must end at the /v1 root. Copy model ids from LM Studio's
# "Developer" / "Local Server" tab.
# ─────────────────────────────────────────────────────────────────────────────
LmStudio__BaseUrl=http://127.0.0.1:1234/v1
LmStudio__ApiKey=your-lm-studio-api-token

# Chat and interpretation. A reasoning model works, but see the "Traps" section of
# docs/data-remodel.md first — it must be called with reasoning_effort "none" or parses come back empty.
# Verified against: qwen/qwen3.6-35b-a3b
LmStudio__Model=your-loaded-model-name

# Optional: smaller model for Athlete Context Card narratives. Defaults to LmStudio__Model.
LmStudio__NarrativeModel=your-loaded-model-name


# ─────────────────────────────────────────────────────────────────────────────
# Embeddings. ALWAYS REQUIRED, whatever serves chat.
#
# Anthropic has no embeddings endpoint, so an Anthropic chat provider still needs an
# OpenAI-compatible server here — "chat on Anthropic, embeddings on LM Studio" is the expected
# production configuration, not a fallback. That is why this block is configured independently
# of the chat provider rather than hanging off it. The host refuses to start without it.
#
# In development, point it at the same LM Studio instance as above.
#
# The model is pinned here because facet resolution snaps proposed values to canonical ones by
# cosine similarity, so the whole vocabulary is embedded with this model. Vectors from different
# models are incomparable: changing it invalidates every stored vector and forces a full
# recompute. Verified against: text-embedding-qwen3-embedding-4b (2560-dim)
# ─────────────────────────────────────────────────────────────────────────────
Embedding__BaseUrl=http://127.0.0.1:1234/v1
Embedding__ApiKey=your-lm-studio-api-token
Embedding__Model=your-loaded-embedding-model-name
