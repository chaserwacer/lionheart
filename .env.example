# LM Studio local server (OpenAI-compatible API).
# BaseUrl must end at the /v1 root. Copy model ids from LM Studio's "Developer" / "Local Server" tab.
LmStudio__BaseUrl=http://127.0.0.1:1234/v1
LmStudio__ApiKey=your-lm-studio-api-token

# Chat and interpretation. A reasoning model works, but see the "Traps" section of
# docs/data-remodel.md first — it must be called with reasoning_effort "none" or parses come back empty.
# Verified against: qwen/qwen3.6-35b-a3b
LmStudio__Model=your-loaded-model-name

# Required. Facet resolution snaps proposed values to canonical ones by cosine similarity, so the
# whole vocabulary is embedded with this model. Vectors from different models are incomparable:
# changing this invalidates every stored vector and forces a full recompute.
# Verified against: text-embedding-qwen3-embedding-4b (2560-dim)
LmStudio__EmbeddingModel=your-loaded-embedding-model-name

# Optional: smaller model for Athlete Context Card narratives. Defaults to LmStudio__Model.
LmStudio__NarrativeModel=your-loaded-model-name
